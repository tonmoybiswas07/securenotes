PORT=5001
MONGODB_URI=mongodb://127.0.0.1:27017/secure-notes?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLIENT_ORIGIN=http://localhost:5173
# Only required when running npm run seed:admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Keep 0 locally. Set only for the verified hosting proxy topology.
TRUST_PROXY_HOPS=0
